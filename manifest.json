{
  "manifest_version": 3,
  "name": "Shortlist",
  "version": "0.1.0",
  "description": "Collect product links into a comparison grid.",
  "action": { "default_title": "Open Shortlist" },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"]
}
